{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mrpatpat/sensor-db/main/data/v1/schemas/calibration.schema.json",
  "title": "Sensor Calibration",
  "description": "Generic calibration data for a sensor, mapping measured input values to calibrated output values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sensor",
    "measurementUnit",
    "valueUnit",
    "calibration"
  ],
  "properties": {
    "schemaVersion": {
      "description": "Version of this calibration document format.",
      "type": "string",
      "const": "1.0.0"
    },
    "sensor": {
      "description": "Identity of the calibrated sensor.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "manufacturer",
        "productNumber"
      ],
      "properties": {
        "id": {
          "description": "Stable identifier for this specific sensor entry.",
          "type": "string",
          "minLength": 1
        },
        "manufacturer": {
          "description": "Sensor manufacturer name.",
          "type": "string",
          "minLength": 1
        },
        "productNumber": {
          "description": "Manufacturer product number, part number, or order code.",
          "type": "string",
          "minLength": 1
        },
        "type": {
          "description": "Optional sensor subtype.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "measurementUnit": {
      "description": "Unit of the measured input values.",
      "type": "string",
      "minLength": 1
    },
    "valueUnit": {
      "description": "Unit of the calibrated output values.",
      "type": "string",
      "minLength": 1
    },
    "calibration": {
      "description": "Calibration table mapping measured input to calibrated output.",
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "measurement",
          "value"
        ],
        "properties": {
          "measurement": {
            "description": "Measured input value in measurementUnit.",
            "type": "number"
          },
          "value": {
            "description": "Calibrated output value in valueUnit.",
            "type": "number"
          }
        }
      }
    }
  }
}
