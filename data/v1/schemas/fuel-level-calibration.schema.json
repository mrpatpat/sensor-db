{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mrpatpat/sensor-db/main/data/v1/schemas/fuel-level-calibration.schema.json",
  "title": "Fuel Level Sender Calibration",
  "description": "Calibration data for a resistive fuel level sender, mapping resistance to fuel level.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sensor",
    "calibration"
  ],
  "properties": {
    "schemaVersion": {
      "description": "Version of this calibration document format.",
      "type": "string",
      "const": "1.0.0"
    },
    "sensor": {
      "description": "Identity of the calibrated fuel level sender.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "manufacturer",
        "productNumber"
      ],
      "properties": {
        "id": {
          "description": "Stable identifier for this specific sensor entry.",
          "type": "string",
          "minLength": 1
        },
        "manufacturer": {
          "description": "Sensor manufacturer name.",
          "type": "string",
          "minLength": 1
        },
        "productNumber": {
          "description": "Manufacturer product number, part number, or order code.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "calibration": {
      "description": "Resistance-to-fuel-level calibration table.",
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resistanceOhms",
          "fuelLevelPercent"
        ],
        "properties": {
          "resistanceOhms": {
            "description": "Nominal sender resistance in ohms.",
            "type": "number",
            "minimum": 0
          },
          "fuelLevelPercent": {
            "description": "Fuel level where 0 is empty and 100 is full.",
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    }
  }
}
